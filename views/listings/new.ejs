<% layout("layouts/boilerplate") %>
    <div class="row">
    <div class="col-6 offset-3">
        <h3>Create new Listings</h3>
    <form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
        <div class="mb-3">
            <div class="mb-3">
    <label for="title" class="form-label">Title</label>

    <input
        name="listing[title]"
        placeholder="Enter title"
        type="text"
        class="form-control"
        id="title"
        maxlength="30"
        required
    >

    <small class="text-muted">
        <span id="titleCount">0</span>/30 characters
    </small>

    <div class="invalid-feedback">
        Title must be between 1 and 30 characters.
    </div>
</div>
        <div class="mb-3">
            <label for="description" class="form-label">Description</label>
            <textarea name="listing[description]" type="text" class="form-control"  required></textarea>
            <div class="invalid-feedback">Please provide a valid description.</div>
        </div>
        <div class="row">
            <div class="mb-3 col-md-4">
            <label for="price" class="form-label">Price</label>
            <input  name="listing[price]"
        placeholder="Enter price"
        type="number"
        class="form-control"
        id="price"
        min="1"
        max="100000000"
        step="1"
    required>
            <div class="invalid-feedback">Please provide a valid price.</div>
            <div class="invalid-feedback">
        Price must be between ₹1 and ₹100,000,000.
    </div>
        </div>
        <div class="mb-3 col-md-8">
            <label for="country" class="form-label">Country</label>
            <input name="listing[country]" placeholder="India" type="text" class="form-control "required>
            <div class="invalid-feedback">Please provide a valid country.</div>
        </div>
        </div>
        

        <div class="mb-3">
    <label class="form-label">Images</label>

    <div id="image-container">

        <div class="image-input mb-2">
            <input
                name="listing[images]"
                type="file"
                class="form-control"
                accept="image/*"
                required
            >
        </div>

    </div>

    <button
        type="button"
        id="add-image"
        class="btn btn-outline-dark btn-sm mt-2"
    >
        + Add image
    </button>

    <div class="form-text">
        You can add multiple images of your property.
    </div>
</div>

        <div class="mb-3">
            <label for="location" class="form-label">Location</label>
            <input name="listing[location]" placeholder="Jaipur,Rajasthan" type="text" class="form-control "required>
            <div class="invalid-feedback">Please provide a valid location.</div>
        </div>
            <div class="mb-3">
    <button type="submit" class="btn btn-dark add-btn">Add</button>
    </div>
    </div>
    </br>

    </form>
    </div>
    </div>

    <script>
    const titleInput = document.getElementById("title");
    const titleCount = document.getElementById("titleCount");

    titleInput.addEventListener("input", function () {
        titleCount.textContent = titleInput.value.length;
    });
</script>

<script>
    const imageContainer = document.getElementById("image-container");
    const addImageButton = document.getElementById("add-image");

    addImageButton.addEventListener("click", function () {

        const imageInput = document.createElement("div");

        imageInput.classList.add("image-input", "mb-2");

        imageInput.innerHTML = `
            <input
                name="listing[images]"
                type="file"
                class="form-control"
                accept="image/*"
            >
        `;

        imageContainer.appendChild(imageInput);
    });
</script>